# ============================================
# Caddyfile — Reverse Proxy + Auto HTTPS
# ============================================
# Replace YOUR_SUBDOMAIN with your DuckDNS subdomain.
# Caddy automatically obtains and renews Let's Encrypt
# certificates — no manual setup needed.
#
# Install on VPS: sudo apt install caddy
# Start: sudo systemctl enable --now caddy
# After editing: sudo systemctl reload caddy

tirth-courserag.duckdns.org {
    # Proxy all traffic to the Docker container
    reverse_proxy localhost:8000

    # Enable WebSocket proxying for /ws/*
    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websockets localhost:8000

    # Security headers
    header {
        X-Content-Type-Options nosniff
        # Allow this app to be embedded in an iframe only from your own sites.
        # (X-Frame-Options DENY blocked all framing; frame-ancestors is the
        #  modern, per-origin replacement.)
        Content-Security-Policy "frame-ancestors 'self' https://tirthpatel.org https://www.tirthpatel.org"
        Referrer-Policy strict-origin-when-cross-origin
    }

    # Logging
    log {
        output file /var/log/caddy/courserag.log
        format console
    }
}
